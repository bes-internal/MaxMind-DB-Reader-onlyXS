TYPEMAP
char *        O_CHAR
MMDB_s *      O_MMDB

INPUT

# this is just here because a O_CHAR input is required to compile,
# should be same as if O_CHAR wasn't defined
O_CHAR
        $var = ($type)SvPVbyte_nolen ($arg)

# only a handle made by _open_mmdb() is accepted (see get_mmdb in the XS code)
O_MMDB
        $var = get_mmdb(aTHX_ $arg, \"$func_name\");

OUTPUT

# prevent memory leaks with malloc'ed returned char * strings
O_CHAR
    if($var != NULL) {
        $arg = newSVpv($var, strlen($var));
        free($var);
        sv_2mortal($arg);
   }

O_MMDB
        set_mmdb_handle(aTHX_ $arg, $var);
